{
  "name": "riordanverse-api-website",
  "version": "4.6.0",
  "description": "Website and frontend assets for Riordanverse API, an unofficial Riordanverse reference API.",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:swagger && npm run build:tailwind && npm run build:scripts",
    "build:swagger": "node build-swagger.mjs",
    "build:clean": "rimraf ../static/css/dist ../static/website/js/dist ../static/vendor/swagger-ui/dist",
    "build:tailwind": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "build:scripts": "node build-scripts.mjs",
    "dev:scripts": "node build-scripts.mjs --watch",
    "dev": "npm run build:swagger && cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "motion": "14.11.1",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "swagger-ui-dist": "5.34.1",
    "tailwindcss": "^4.3.3"
  }
}
