SECRET_KEY=
# Optional release/build identifier returned by health endpoints.
APP_VERSION=1.0.0
DEBUG=True
# Local defaults. Intended production host: riordanverse.cc (configure after DNS/HTTPS setup).
ALLOWED_HOSTS=localhost,127.0.0.1
# Intended production trusted origin: https://riordanverse.cc
CSRF_TRUSTED_ORIGINS=

# Sender identity only; mailboxes do not configure an outbound email provider.
DEFAULT_FROM_EMAIL=Riordanverse API <support@riordanverse.cc>
SERVER_EMAIL=support@riordanverse.cc

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/1

# Comma-separated frontend origins (scheme + host + optional port); empty disables cross-origin access.
# Example: https://your-frontend.example,http://localhost:8080
CORS_ALLOWED_ORIGINS=

API_KEY_CUSTOM_HEADER=HTTP_X_API_KEY